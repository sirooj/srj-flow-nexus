//@version=5
// HORC Opening Range - alert-only drawing indicator (TradingView twin of the MQL5 file).
// Status UNRULED 2026-09-30 (books uncorrected; not his strategy).
// Draws per reference period: ORH/ORL, touch-first signal, 3-move cycle legs,
// ORT = leg-1 raid extreme (vault finding 07), passive zones + used marks.
// Session opens + opposition logics deferred to v2. Alerts only, no orders.
indicator("HORC Opening Range", shorttitle="HORC OR", overlay=true,
     max_lines_count=500, max_boxes_count=500, max_labels_count=500)

refTF     = input.timeframe("D", "Reference period")
raidPts   = input.int(10, "Raid exceedance (points)", minval=0)
maxZones  = input.int(5, "Max zones kept", minval=1)
showZones = input.bool(true, "Draw passive zones")
showORT   = input.bool(true, "Draw ORT")
showSig   = input.bool(true, "Draw signals")

tfSec = timeframe.in_seconds(refTF)
if timeframe.in_seconds() >= tfSec
    runtime.error("Attach to a lower timeframe than the reference period.")

pt  = syminfo.mintick
orh = request.security(syminfo.tickerid, refTF, high[1], lookahead=barmerge.lookahead_on)
orl = request.security(syminfo.tickerid, refTF, low[1], lookahead=barmerge.lookahead_on)
pOpen     = request.security(syminfo.tickerid, refTF, time, lookahead=barmerge.lookahead_on)
newPeriod = ta.change(pOpen) != 0

var int   sig    = 0
var bool  leg1   = false
var float ort    = na
var bool  leg2   = false
var bool  done   = false
var line  orhL   = na
var line  orlL   = na
var line  ortL   = na
var box   zbox   = na
var box   dayBand = na
var bool  zused  = false
var array<box> zhist = array.new<box>()
var int   ySig = 0
var int   mSig = 0
var int   wSig = 0
var array<float> thi = array.new_float()
var array<float> tlo = array.new_float()
var array<line> thiL = array.new_line()
var array<line> tloL = array.new_line()
var label tgtL = na
var bool  fSig   = false
var bool  fDone  = false
var bool  fUsed  = false

if barstate.isnew
    fSig  := false
    fDone := false
    fUsed := false

if newPeriod
    if not na(orhL)
        line.set_x2(orhL, bar_index)
    if not na(orlL)
        line.set_x2(orlL, bar_index)
    if not na(ortL)
        line.set_x2(ortL, bar_index)
    sig   := 0
    leg1  := false
    ort   := na
    leg2  := false
    done  := false
    zbox  := na
    zused := false
    ortL  := na
    orhL  := line.new(bar_index, orh, bar_index + 1, orh, extend=extend.none, color=color.new(color.blue, 0), width=1)
    orlL  := line.new(bar_index, orl, bar_index + 1, orl, extend=extend.none, color=color.new(color.red, 0), width=1)
    dayBand := box.new(bar_index, orh, bar_index + 1, orl, bgcolor=color.new(color.gray, 93), border_color=color.new(color.gray, 93))
    for i = 0 to array.size(thiL) - 1
        line.delete(array.get(thiL, i))
    for i = 0 to array.size(tloL) - 1
        line.delete(array.get(tloL, i))
    array.clear(thi)
    array.clear(tlo)
    array.clear(thiL)
    array.clear(tloL)
    if not na(tgtL)
        label.delete(tgtL)
        tgtL := na

if not na(orhL)
    line.set_x2(orhL, bar_index + 1)
if not na(orlL)
    line.set_x2(orlL, bar_index + 1)
if not na(ortL)
    line.set_x2(ortL, bar_index + 1)
if not na(zbox)
    box.set_right(zbox, bar_index + 1)
if not na(dayBand)
    box.set_right(dayBand, bar_index + 1)

yOrh = request.security(syminfo.tickerid, "12M", high[1], lookahead=barmerge.lookahead_on)
yOrl = request.security(syminfo.tickerid, "12M", low[1], lookahead=barmerge.lookahead_on)
yOpen = request.security(syminfo.tickerid, "12M", time, lookahead=barmerge.lookahead_on)
mOrh = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_on)
mOrl = request.security(syminfo.tickerid, "M", low[1], lookahead=barmerge.lookahead_on)
mOpen = request.security(syminfo.tickerid, "M", time, lookahead=barmerge.lookahead_on)
wOrh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
wOrl = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_on)
wOpen = request.security(syminfo.tickerid, "W", time, lookahead=barmerge.lookahead_on)

conf = barstate.isconfirmed
raid = raidPts * pt

if ta.change(yOpen) != 0
    ySig := 0
if ta.change(mOpen) != 0
    mSig := 0
if ta.change(wOpen) != 0
    wSig := 0

if conf and ySig == 0 and not na(yOrh)
    if high >= yOrh and not (low <= yOrl)
        ySig := 1
        label.new(bar_index, low, "Y+", style=label.style_label_up, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
    if low <= yOrl and not (high >= yOrh)
        ySig := -1
        label.new(bar_index, high, "Y-", style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
if conf and mSig == 0 and not na(mOrh)
    if high >= mOrh and not (low <= mOrl)
        mSig := 1
        label.new(bar_index, low, "M+", style=label.style_label_up, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
    if low <= mOrl and not (high >= mOrh)
        mSig := -1
        label.new(bar_index, high, "M-", style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
if conf and wSig == 0 and not na(wOrh)
    if high >= wOrh and not (low <= wOrl)
        wSig := 1
        label.new(bar_index, low, "W+", style=label.style_label_up, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
    if low <= wOrl and not (high >= wOrh)
        wSig := -1
        label.new(bar_index, high, "W-", style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)

if conf and sig == 0
    up = high >= orh
    dn = low <= orl
    if up and not dn
        sig := 1
        fSig := true
        if showSig
            label.new(bar_index, low, "D+", style=label.style_label_up, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
    if dn and not up
        sig := -1
        fSig := true
        if showSig
            label.new(bar_index, high, "D-", style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)

if conf and sig == 1 and not leg1
    if high >= orh + raid
        leg1 := true
        ort := high
        if showORT
            ortL := line.new(bar_index, ort, bar_index + 1, ort, extend=extend.none, color=color.new(color.yellow, 0), width=2)
        if showZones
            zbox := box.new(bar_index, orh, bar_index + 1, ort, bgcolor=color.new(color.blue, 80), border_color=color.new(color.blue, 0), text="HORC passive demand", text_size=size.small)
            label.new(bar_index, orh, "ENTRY", style=label.style_label_up, color=color.new(color.blue, 0), textcolor=color.white, size=size.small)
            array.push(zhist, zbox)
            if array.size(zhist) > maxZones
                box.delete(array.shift(zhist))

if conf and sig == -1 and not leg1
    if low <= orl - raid
        leg1 := true
        ort := low
        if showORT
            ortL := line.new(bar_index, ort, bar_index + 1, ort, extend=extend.none, color=color.new(color.yellow, 0), width=2)
        if showZones
            zbox := box.new(bar_index, ort, bar_index + 1, orl, bgcolor=color.new(color.maroon, 80), border_color=color.new(color.maroon, 0), text="HORC passive supply", text_size=size.small)
            label.new(bar_index, orl, "ENTRY", style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=size.small)
            array.push(zhist, zbox)
            if array.size(zhist) > maxZones
                box.delete(array.shift(zhist))

if conf and array.size(thi) < 3
    if high >= orh + raid and (array.size(thi) == 0 or high >= array.get(thi, array.size(thi) - 1) + raid)
        array.push(thi, high)
        array.push(thiL, line.new(bar_index, high, bar_index + 1, high, extend=extend.none, color=color.new(color.orange, 0), width=1))
if conf and array.size(tlo) < 3
    if low <= orl - raid and (array.size(tlo) == 0 or low <= array.get(tlo, array.size(tlo) - 1) - raid)
        array.push(tlo, low)
        array.push(tloL, line.new(bar_index, low, bar_index + 1, low, extend=extend.none, color=color.new(color.orange, 0), width=1))
if array.size(thiL) > 0
    for i = 0 to array.size(thiL) - 1
        line.set_x2(array.get(thiL, i), bar_index + 1)
if array.size(tloL) > 0
    for i = 0 to array.size(tloL) - 1
        line.set_x2(array.get(tloL, i), bar_index + 1)

if conf and sig == 1 and array.size(thi) > 0
    bestHi = float(na)
    for i = 0 to array.size(thi) - 1
        v = array.get(thi, i)
        if v > close and (na(bestHi) or v < bestHi)
            bestHi := v
    if not na(bestHi)
        if na(tgtL)
            tgtL := label.new(bar_index, bestHi, "TARGET", style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.black, size=size.small)
        else
            label.set_xy(tgtL, bar_index, bestHi)
    else
        if not na(tgtL)
            label.delete(tgtL)
            tgtL := na
if conf and sig == -1 and array.size(tlo) > 0
    bestLo = float(na)
    for i = 0 to array.size(tlo) - 1
        v = array.get(tlo, i)
        if v < close and (na(bestLo) or v > bestLo)
            bestLo := v
    if not na(bestLo)
        if na(tgtL)
            tgtL := label.new(bar_index, bestLo, "TARGET", style=label.style_label_up, color=color.new(color.orange, 0), textcolor=color.black, size=size.small)
        else
            label.set_xy(tgtL, bar_index, bestLo)
    else
        if not na(tgtL)
            label.delete(tgtL)
            tgtL := na

if conf and leg1 and not leg2
    if sig == 1 and low <= orl
        leg2 := true
    if sig == -1 and high >= orh
        leg2 := true

if conf and leg1 and not na(zbox) and not zused
    if sig == 1 and close > ort
        zused := true
        fUsed := true
        box.set_bgcolor(zbox, color.new(color.gray, 80))
        box.set_text(zbox, "HORC passive demand | used")
    if sig == -1 and close < ort
        zused := true
        fUsed := true
        box.set_bgcolor(zbox, color.new(color.gray, 80))
        box.set_text(zbox, "HORC passive supply | used")

if conf and leg2 and not done
    if sig == 1 and high >= ort
        done := true
        fDone := true
        label.new(bar_index, low, "ORT", style=label.style_label_up, color=color.new(color.yellow, 0), textcolor=color.black, size=size.small)
    if sig == -1 and low <= ort
        done := true
        fDone := true
        label.new(bar_index, high, "ORT", style=label.style_label_down, color=color.new(color.yellow, 0), textcolor=color.black, size=size.small)

alertcondition(fSig, title="HORC signal", message="HORC signal on {{ticker}} {{interval}}")
alertcondition(fDone, title="HORC cycle complete", message="HORC cycle complete at ORT on {{ticker}} {{interval}}")
alertcondition(fUsed, title="HORC zone used", message="HORC passive zone used on {{ticker}} {{interval}}")
